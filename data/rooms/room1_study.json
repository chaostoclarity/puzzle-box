    {
     "set": "letter_read"
    },
    {
     "journal": [
      "letter",
      "Wren's letter",
      "\"Elias. Do not open it. I opened three.\n\nIf you must be the fool I was, begin at our hour. I keep it where I keep everything that matters to me: under my feet, beneath my desk. Set my clock by it and wind it. The box remembers what I forget.\n\nH.W.\""
     ]
    }
   ],
   "said": "The letter unfolds itself on the desk."
  },
  {
   "id": "watch",
   "done": "watch_taken",
   "hints": [
