   "do": [
    {
     "set": "diary_read"
    },
    {
     "sfx": "paper"
    },
    {
     "journal": [
      "ada_diary",
      "Ada Merrow's diary",
      "Pages sewn into the mattress ticking, in a small careful hand:\n\n\"Admitted 1911. They say I tried to open something that should stay shut. I say I was nearly through.\"\n\n\"The stool walks when I do not watch it. I have counted. It rests beneath the window on the fourth look, and on every tenth look after that.\"\n\n\"I broke my key in two to keep it from them. One half where the water goes. One half where only the stool can take me.\"\n\n\"My pins are on my handkerchief. The last row they tore away. I put it where they never look.\""
     ]
    },
    {
     "say": "Pages sewn into the mattress. Ada Merrow's diary. It's in your journal.",
     "secs": 5
    }
   ]
  },
  {
   "on": "tap",
   "id": "kerchief",
   "do": [
    {
     "journal": [
      "kerchief",
      "The handkerchief",
      "Pinned above the cot: a handkerchief embroidered with a grid of nine squares. Some are crossed through in red. The right-hand column has been torn away."
     ]
    },
    {
     "say": "A handkerchief: a grid of nine squares, some crossed. The right column is torn away."
    }
   ]
  },
  {
   "on": "tap",
   "id": "ada_note",
   "do": [
    {
     "journal": [
      "ada_note",
      "Scratched note",
